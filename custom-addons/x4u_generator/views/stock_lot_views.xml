<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_x4u_generator" model="ir.ui.view">
        <field name="name">stock.lot.form.x4u.generator</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- First in the box: the QC buttons of quality_control_stock_oca push
                 later buttons under "More". -->
            <xpath expr="//div[@name='button_box']/*[1]" position="before">
                <button name="action_x4u_open_generator_card" type="object" class="oe_stat_button"
                        icon="fa-bolt" string="Generator Card" invisible="not x4u_generator_id"/>
                <button name="action_x4u_create_generator_card" type="object" class="oe_stat_button"
                        icon="fa-plus-square" string="Create Generator Card"
                        invisible="x4u_generator_id or not x4u_is_generator"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="x4u_is_generator" invisible="1"/>
                <field name="x4u_generator_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
