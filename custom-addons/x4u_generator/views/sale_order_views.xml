<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_x4u_generator" model="ir.ui.view">
        <field name="name">sale.order.form.x4u.generator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_x4u_view_generators" type="object" class="oe_stat_button" icon="fa-bolt"
                        invisible="x4u_generator_count == 0"
                        groups="stock.group_stock_user,sales_team.group_sale_salesman">
                    <field name="x4u_generator_count" widget="statinfo" string="Generators"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
