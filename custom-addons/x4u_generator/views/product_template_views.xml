<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_x4u_generator" model="ir.ui.view">
        <field name="name">product.template.form.x4u.generator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="x4u_is_generator"/>
                    <label for="x4u_is_generator"/>
                </span>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Generator" name="x4u_generator" invisible="not x4u_is_generator">
                    <group>
                        <group string="Rating" name="x4u_rating">
                            <field name="x4u_kva_prime"/>
                            <field name="x4u_kva_standby"/>
                        </group>
                        <group string="Warranty" name="x4u_warranty">
                            <field name="x4u_warranty_months"/>
                            <field name="x4u_warranty_hours"/>
                            <field name="x4u_warranty_max_delivery_months"/>
                        </group>
                        <group string="Engine" name="x4u_engine">
                            <field name="x4u_engine_brand_id" options="{'no_create': True}"/>
                            <field name="x4u_engine_model"/>
                        </group>
                        <group string="Alternator" name="x4u_alternator">
                            <field name="x4u_alternator_brand_id" options="{'no_create': True}"/>
                            <field name="x4u_alternator_model"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
