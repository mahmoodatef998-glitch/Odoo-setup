<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x4u_job_order spec v0.8 N2: Purchasing receives what it bought and writes the engine
         serials; it reads the other transfers and changes none of them. Group rules: a user of
         this group changes a transfer only when one of them matches. -->
    <record id="group_x4u_receipts_only" model="res.groups">
        <field name="name">Receipts Only</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Validates receipts and writes their serials; reads the other transfers without changing them.</field>
    </record>
    <record id="rule_stock_picking_receipts_only" model="ir.rule">
        <field name="name">Receipts Only: change receipts only</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[('picking_type_code', '=', 'incoming')]</field>
        <field name="groups" eval="[Command.link(ref('group_x4u_receipts_only'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_stock_move_receipts_only" model="ir.rule">
        <field name="name">Receipts Only: change receipt moves only</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="domain_force">[('picking_code', '=', 'incoming')]</field>
        <field name="groups" eval="[Command.link(ref('group_x4u_receipts_only'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_stock_move_line_receipts_only" model="ir.rule">
        <field name="name">Receipts Only: change receipt lines only</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">[('picking_code', '=', 'incoming')]</field>
        <field name="groups" eval="[Command.link(ref('group_x4u_receipts_only'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
</odoo>
