<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Apps (install / remove modules) with Settings, for the Administrator only (the user,
         2026-11-21: "الاعدادات معايا أنا بس"). Others could open the list but not install. -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
    <!-- The Manufacturing app for the read-only buyers too (group_x4u_mrp_viewer). Its Configuration
         stays with the Manufacturing managers. -->
    <record id="mrp.menu_mrp_root" model="ir.ui.menu">
        <field name="groups_id" eval="[Command.link(ref('group_x4u_mrp_viewer'))]"/>
    </record>
</odoo>
