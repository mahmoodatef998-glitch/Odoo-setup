<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deliver Materials (spec v0.4 V3): the Storekeeper sends the parts to the factory -->
    <record id="x4u_job_order_deliver_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.deliver.form</field>
        <field name="model">x4u.job.order.deliver</field>
        <field name="arch" type="xml">
            <form string="Deliver Materials">
                <field name="production_id" invisible="1"/>
                <p class="text-muted">
                    The quantities leave WH/Stock for the factory. A part left at 0 stays reserved
                    for this Job Order and waits for the next delivery.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_id" column_invisible="1"/>
                        <field name="x4u_role"/>
                        <field name="product_id"/>
                        <field name="needed"/>
                        <field name="reserved"/>
                        <field name="on_hand"/>
                        <field name="free"/>
                        <field name="quantity" decoration-bf="1"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
