<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deliver Materials (spec v0.4 V3): the Storekeeper sends the parts to the factory.
         Spec v0.8: parts free in stock (F2), the engine serial needed (N3), the alternator's optional (N4). -->
    <record id="x4u_job_order_deliver_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.deliver.form</field>
        <field name="model">x4u.job.order.deliver</field>
        <field name="arch" type="xml">
            <form string="Deliver Materials">
                <field name="production_id" invisible="1"/>
                <p class="text-muted">
                    The quantities leave WH/Stock for the factory. Pick each engine's or CKD's serial from the list;
                    the alternator's when it has one. A part left at 0 waits for the next delivery.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="available_lot_ids" column_invisible="1"/>
                        <field name="available_alternator_ids" column_invisible="1"/>
                        <field name="x4u_role"/>
                        <field name="product_id"/>
                        <field name="needed"/>
                        <field name="on_hand"/>
                        <field name="lot_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_lot_ids)]"
                               invisible="tracking != 'serial'"
                               placeholder="Pick the serial"/>
                        <field name="alternator_serial_id" options="{'no_open': True}"
                               domain="[('id', 'in', available_alternator_ids)]"
                               context="{'default_product_id': product_id}"
                               invisible="x4u_role != 'alternator'"
                               placeholder="Optional"/>
                        <field name="quantity" decoration-bf="1" readonly="tracking == 'serial'"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Spec v0.11 D1: the generators of an order in one screen, a line per generator -->
    <record id="x4u_job_order_deliver_all_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.deliver.all.form</field>
        <field name="model">x4u.job.order.deliver.all</field>
        <field name="arch" type="xml">
            <form string="Deliver Materials">
                <p class="text-muted">
                    A line per generator: pick its engine (or CKD) and canopy serials, and the alternator's when it has one.
                    The other parts go from what is in stock. A generator left without serials waits for the next delivery,
                    and a part by serial goes only with its serial.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="engine_move_id" column_invisible="1"/>
                        <field name="alternator_move_id" column_invisible="1"/>
                        <field name="body_move_id" column_invisible="1"/>
                        <field name="available_engine_lot_ids" column_invisible="1"/>
                        <field name="available_alternator_ids" column_invisible="1"/>
                        <field name="available_body_lot_ids" column_invisible="1"/>
                        <field name="production_id"/>
                        <field name="product_id" optional="show"/>
                        <field name="engine_product_id" optional="show"/>
                        <field name="engine_lot_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_engine_lot_ids)]"
                               readonly="not engine_move_id" placeholder="Pick the serial"/>
                        <field name="alternator_serial_id" options="{'no_open': True}"
                               domain="[('id', 'in', available_alternator_ids)]"
                               readonly="not alternator_move_id" placeholder="Optional"/>
                        <field name="body_lot_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_body_lot_ids)]"
                               readonly="not body_move_id" placeholder="Pick the serial"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Spec v0.11 D2: Finish Job Order, the serials fitted in the generator -->
    <record id="x4u_job_order_finish_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.finish.form</field>
        <field name="model">x4u.job.order.finish</field>
        <field name="arch" type="xml">
            <form string="Finish Job Order">
                <field name="production_id" invisible="1"/>
                <field name="engine_move_id" invisible="1"/>
                <field name="alternator_move_id" invisible="1"/>
                <field name="body_move_id" invisible="1"/>
                <field name="available_engine_lot_ids" invisible="1"/>
                <field name="available_alternator_ids" invisible="1"/>
                <field name="available_body_lot_ids" invisible="1"/>
                <p class="text-muted">
                    The serials fitted in this generator, as delivered. If the factory fitted another unit of the same part
                    (from another generator), pick it here: that generator takes this one's unit instead.
                </p>
                <group>
                    <group invisible="not engine_move_id">
                        <field name="engine_product_id"/>
                        <field name="engine_lot_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_engine_lot_ids)]" required="engine_move_id"/>
                    </group>
                    <group invisible="not body_move_id">
                        <field name="body_product_id"/>
                        <field name="body_lot_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_body_lot_ids)]" required="body_move_id"/>
                    </group>
                    <group invisible="not alternator_move_id">
                        <field name="alternator_product_id"/>
                        <field name="alternator_serial_id" options="{'no_open': True}"
                               domain="[('id', 'in', available_alternator_ids)]"
                               context="{'default_product_id': alternator_product_id}" placeholder="Optional"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Finish Job Order" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Use CKD (spec v0.9 C3): a CKD instead of the engine and the alternator of one Job Order -->
    <record id="x4u_job_order_ckd_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.ckd.form</field>
        <field name="model">x4u.job.order.ckd</field>
        <field name="arch" type="xml">
            <form string="Use CKD">
                <field name="production_id" invisible="1"/>
                <field name="allowed_product_ids" invisible="1"/>
                <p class="text-muted">
                    The CKD (engine and alternator on one serial) takes the place of the engine and the alternator;
                    the body stays. The material request follows: the engine and the alternator leave it unless they
                    are already on an RFQ, and the CKD is requested if the stock does not cover it.
                </p>
                <group>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="on_hand" invisible="not product_id"/>
                    <field name="free_qty" invisible="not product_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Use CKD" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
