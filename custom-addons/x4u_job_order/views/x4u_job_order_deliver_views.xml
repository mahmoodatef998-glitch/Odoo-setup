<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deliver Materials (spec v0.4 V3): the Storekeeper sends the parts to the factory.
         Spec v0.8: parts free in stock (F2), the engine serial needed (N3), the alternator's optional (N4). -->
    <record id="x4u_job_order_deliver_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.deliver.form</field>
        <field name="model">x4u.job.order.deliver</field>
        <field name="arch" type="xml">
            <form string="Deliver Materials">
                <field name="production_id" invisible="1"/>
                <p class="text-muted">
                    The quantities leave WH/Stock for the factory. Pick each engine's serial from the list;
                    the alternator's when it has one. A part left at 0 waits for the next delivery.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="available_lot_ids" column_invisible="1"/>
                        <field name="available_alternator_ids" column_invisible="1"/>
                        <field name="x4u_role"/>
                        <field name="product_id"/>
                        <field name="needed"/>
                        <field name="on_hand"/>
                        <field name="lot_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_lot_ids)]"
                               invisible="tracking != 'serial'"
                               placeholder="Pick the engine"/>
                        <field name="alternator_serial_id" options="{'no_open': True}"
                               domain="[('id', 'in', available_alternator_ids)]"
                               context="{'default_product_id': product_id}"
                               invisible="x4u_role != 'alternator'"
                               placeholder="Optional"/>
                        <field name="quantity" decoration-bf="1" readonly="tracking == 'serial'"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
