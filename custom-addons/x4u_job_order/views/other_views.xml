<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Generator card: enclosure of the variant sold -->
    <record id="x4u_generator_view_form_x4u_job_order" model="ir.ui.view">
        <field name="name">x4u.generator.form.x4u.job.order</field>
        <field name="model">x4u.generator</field>
        <field name="inherit_id" ref="x4u_generator.x4u_generator_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='rating']" position="inside">
                <field name="x4u_enclosure"/>
                <field name="x4u_supplier_serial"/>
            </xpath>
            <!-- Spec v0.8 N5: the engine fitted, linked to its serial in stock, not typed by hand -->
            <xpath expr="//field[@name='engine_serial']" position="attributes">
                <attribute name="readonly">x4u_engine_linked</attribute>
            </xpath>
            <xpath expr="//field[@name='engine_serial']" position="after">
                <field name="x4u_engine_linked" invisible="1"/>
                <field name="x4u_engine_lot_id" invisible="not x4u_engine_lot_id" groups="stock.group_stock_user"/>
                <!-- Spec v0.10 B3: the body fitted, by its serial -->
                <field name="x4u_body_serial" invisible="not x4u_body_serial"/>
                <field name="x4u_body_lot_id" invisible="not x4u_body_lot_id" groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>

    <!-- Spec v0.10 S2: a card by any serial on it, or by the PI of its sales order -->
    <record id="x4u_generator_view_search_x4u_job_order" model="ir.ui.view">
        <field name="name">x4u.generator.search.x4u.job.order</field>
        <field name="model">x4u.generator</field>
        <field name="inherit_id" ref="x4u_generator.x4u_generator_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x4u_serial_search"/>
                <field name="x4u_proforma_search"/>
            </xpath>
        </field>
    </record>

    <!-- Settings › Manufacturing › 4U Job Orders -->
    <record id="res_config_settings_view_form_x4u_job_order" model="ir.ui.view">
        <field name="name">res.config.settings.form.x4u.job.order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="4U Job Orders" name="x4u_job_order_settings">
                    <setting string="Who gets the activities" help="Purchasing Officer: new material request. Storekeeper: no to-do since spec v0.8, you choose which Job Order gets the parts. Operation Manager: materials delivered, finish the Job Order.">
                        <div class="row">
                            <label for="x4u_purchase_user_id" class="col-lg-4"/>
                            <field name="x4u_purchase_user_id"/>
                        </div>
                        <div class="row">
                            <label for="x4u_warehouse_user_id" class="col-lg-4"/>
                            <field name="x4u_warehouse_user_id"/>
                        </div>
                        <div class="row">
                            <label for="x4u_operation_user_id" class="col-lg-4"/>
                            <field name="x4u_operation_user_id"/>
                        </div>
                    </setting>
                    <setting string="Generator value" help="A finished generator enters stock at what its parts cost plus this percentage (0 = parts only).">
                        <field name="x4u_overhead_percent"/>
                    </setting>
                    <setting string="Target days per stage" help="0 = no target. A Job Order shows 'Delay At' for the first stage that takes longer.">
                        <div class="row"><label for="x4u_target_purchasing_days" string="Purchasing" class="col-lg-4"/><field name="x4u_target_purchasing_days"/></div>
                        <div class="row"><label for="x4u_target_approval_days" string="Approval" class="col-lg-4"/><field name="x4u_target_approval_days"/></div>
                        <div class="row"><label for="x4u_target_supplier_days" string="Supplier delivery" class="col-lg-4"/><field name="x4u_target_supplier_days"/></div>
                        <div class="row"><label for="x4u_target_warehouse_days" string="Warehouse issue" class="col-lg-4"/><field name="x4u_target_warehouse_days"/></div>
                        <div class="row"><label for="x4u_target_assembly_days" string="Production" class="col-lg-4"/><field name="x4u_target_assembly_days"/></div>
                        <div class="row"><label for="x4u_target_dispatch_days" string="Dispatch" class="col-lg-4"/><field name="x4u_target_dispatch_days"/></div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- x4u_generator_datasheet §9: the letterhead of the 4U quotation -->
    <record id="view_company_form_x4u_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.x4u.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="4U Letterhead" name="x4u_letterhead">
                    <group>
                        <field name="x4u_letterhead_header" widget="image" options="{'size': [0, 90]}"/>
                        <field name="x4u_letterhead_footer" widget="image" options="{'size': [0, 40]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- x4u_account spec §20 P3: the serials on the Receipts / Deliveries list, searchable -->
    <record id="vpicktree_x4u_serials" model="ir.ui.view">
        <field name="name">stock.picking.list.x4u.serials</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="x4u_serials" optional="show"/>
            </field>
        </field>
    </record>
    <record id="view_picking_internal_search_x4u_serials" model="ir.ui.view">
        <field name="name">stock.picking.search.x4u.serials</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="x4u_serials" string="Serial Number"/>
            </field>
        </field>
    </record>
    <!-- The generator's serial on the Manufacturing Orders list -->
    <record id="mrp_production_tree_view_x4u_serial" model="ir.ui.view">
        <field name="name">mrp.production.list.x4u.serial</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="lot_producing_id" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Generator Serial</attribute>
            </field>
        </field>
    </record>
</odoo>
