<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spec v0.8.1 N4: alternator serials, written at the receipt when known -->
    <record id="x4u_alternator_serial_view_list" model="ir.ui.view">
        <field name="name">x4u.alternator.serial.list</field>
        <field name="model">x4u.alternator.serial</field>
        <field name="arch" type="xml">
            <list string="Alternator Serials">
                <field name="name"/>
                <field name="product_id" options="{'no_create': True}"/>
                <field name="state" widget="badge" decoration-success="state == 'in_stock'" decoration-muted="state == 'fitted'"/>
                <field name="picking_id"/>
                <field name="production_id"/>
                <field name="company_id" groups="base.group_multi_company" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Spec v0.9 E1-E2: the serial changes by the Administrator, the GM or the Operation Manager
         only, and each change stays in the chatter. -->
    <record id="x4u_alternator_serial_view_form" model="ir.ui.view">
        <field name="name">x4u.alternator.serial.form</field>
        <field name="model">x4u.alternator.serial</field>
        <field name="arch" type="xml">
            <form string="Alternator Serial">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. A-77"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="state" widget="badge" decoration-success="state == 'in_stock'" decoration-muted="state == 'fitted'"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="production_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="x4u_alternator_serial_view_search" model="ir.ui.view">
        <field name="name">x4u.alternator.serial.search</field>
        <field name="model">x4u.alternator.serial</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <filter name="in_stock" string="In Stock" domain="[('state', '=', 'in_stock')]"/>
                <filter name="fitted" string="Fitted" domain="[('state', '=', 'fitted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Alternator" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_x4u_alternator_serial" model="ir.actions.act_window">
        <field name="name">Alternator Serials</field>
        <field name="res_model">x4u.alternator.serial</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_stock': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No alternator serial yet</p>
            <p>Write them on the receipt (column Alternator Serials) when they are known; Deliver Materials then offers them in a list.</p>
        </field>
    </record>

    <menuitem id="menu_x4u_alternator_serial" name="Alternator Serials" parent="stock.menu_stock_inventory_control"
              action="action_x4u_alternator_serial" sequence="25" groups="stock.group_stock_user"/>

    <!-- The receipt: the serials of the engines, CKDs, canopies and alternators (spec v0.15 B2) -->
    <record id="view_picking_form_x4u_alternator_serials" model="ir.ui.view">
        <field name="name">stock.picking.form.x4u.alternator.serials</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='lot_ids']" position="after">
                <field name="x4u_role" column_invisible="True"/>
                <!-- Spec v0.8 N2: the serial of each engine, CKD, canopy or alternator received, all in
                     one Serials column (the user, 2026-11-25: no separate column for the alternator) -->
                <field name="x4u_serials" optional="show"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       invisible="x4u_role not in ('engine', 'ckd', 'body', 'alternator')"
                       required="x4u_role in ('engine', 'ckd', 'body', 'alternator') and quantity and parent.state not in ('draft', 'done', 'cancel')"
                       readonly="state in ('done', 'cancel')"
                       placeholder="E-1001, E-1002"/>
            </xpath>
        </field>
    </record>

    <!-- Spec v0.15 B1: on the purchase order, what is still to buy to cover the open orders -->
    <record id="purchase_order_form_x4u_needed" model="ir.ui.view">
        <field name="name">purchase.order.form.x4u.needed</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <field name="x4u_needed_qty" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
