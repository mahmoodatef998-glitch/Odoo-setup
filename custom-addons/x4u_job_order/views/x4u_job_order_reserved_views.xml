<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reserved for Other Orders (spec v0.6 R1-R3) -->
    <record id="x4u_job_order_reserved_view_form" model="ir.ui.view">
        <field name="name">x4u.job.order.reserved.form</field>
        <field name="model">x4u.job.order.reserved</field>
        <field name="arch" type="xml">
            <form string="Reserved for Other Orders">
                <field name="production_id" invisible="1"/>
                <field name="can_move" invisible="1"/>
                <p class="text-muted" invisible="not line_ids">
                    The parts are in stock but reserved for these Job Orders. Tick the order whose part
                    this Job Order should take: that order goes back to Waiting Parts and its part is
                    requested again. If all of them come first, buy new parts instead.
                </p>
                <p class="text-muted" invisible="line_ids">
                    No other Job Order holds these parts: they have to be bought.
                </p>
                <p class="text-warning" invisible="can_move">
                    Only the Operation Manager or the General Manager can move parts between Job Orders
                    or ask to buy new ones.
                </p>
                <field name="line_ids" invisible="not line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" readonly="not parent.can_move"/>
                        <field name="donor_move_id" column_invisible="1"/>
                        <field name="donor_production_id"/>
                        <field name="customer"/>
                        <field name="sale_order" optional="show"/>
                        <field name="promised_date" optional="show"/>
                        <field name="job_state" widget="badge"/>
                        <field name="confirmed_on" optional="hide"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="needed"/>
                    </list>
                </field>
                <footer>
                    <button name="action_take" type="object" string="Take for This Order" class="btn-primary"
                            invisible="not can_move or not line_ids" data-hotkey="q"/>
                    <button name="action_buy" type="object" string="Buy New Parts" class="btn-secondary"
                            invisible="not can_move" data-hotkey="b"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
