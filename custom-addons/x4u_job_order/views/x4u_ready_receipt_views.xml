<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spec v0.8 N7: the serials of a ready generator, asked when its receipt is validated -->
    <record id="x4u_ready_receipt_view_form" model="ir.ui.view">
        <field name="name">x4u.ready.receipt.form</field>
        <field name="model">x4u.ready.receipt</field>
        <field name="arch" type="xml">
            <form string="Ready Generator Serials">
                <field name="picking_ids" invisible="1"/>
                <p class="text-muted">
                    From the supplier's papers: the engine serial of each generator is needed,
                    the alternator and supplier serials when known. They go on the generator card.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="ready_order_id"/>
                        <field name="product_id"/>
                        <field name="engine_serial" required="1"/>
                        <field name="alternator_serial"/>
                        <field name="supplier_serial"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Validate" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
