<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only Job Orders for people who are told about one but don't make it:
         Purchasing (material to order) and Quality (generator to inspect). -->
    <record id="group_x4u_job_order_viewer" model="res.groups">
        <field name="name">Job Orders: Read Only</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Opens the Job Orders, their parts and timeline, without changing them.</field>
    </record>
    <!-- Spec v0.9 E1: changing a serial after the receipt (engine, CKD, generator, alternator).
         x4u_roles gives it to the General Manager and the Operation Manager; every administrator
         has it. -->
    <record id="group_x4u_edit_serials" model="res.groups">
        <field name="name">Edit Serials</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Changes a serial number after the receipt; each change is kept in the serial's chatter.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_x4u_edit_serials'))]"/>
    </record>

    <data noupdate="1">
        <record id="x4u_job_order_event_company_rule" model="ir.rule">
            <field name="name">Job Order Event: multi-company</field>
            <field name="model_id" ref="model_x4u_job_order_event"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="x4u_ready_order_company_rule" model="ir.rule">
            <field name="name">Ready Job Order: multi-company</field>
            <field name="model_id" ref="model_x4u_ready_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
