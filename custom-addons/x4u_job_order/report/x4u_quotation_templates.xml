<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x4u_generator_datasheet §9: the 4U quotation in the QT 1112 layout - letterhead, Prepared for /
         Prepared by, Requirement, the generators (options A / B / C or plain lines), Delivery,
         Price Summary (each option its own total), Terms & Conditions. Tables only: wkhtmltopdf. -->
    <record id="paperformat_x4u_quotation" model="report.paperformat">
        <field name="name">4U Quotation (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_x4u_quotation" model="ir.actions.report">
        <field name="name">Quotation (4U)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x4u_job_order.report_x4u_quotation</field>
        <field name="report_file">x4u_job_order.report_x4u_quotation</field>
        <field name="print_report_name">'%s %s' % ('Quotation' if object.state in ('draft', 'sent') else 'Order', object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_x4u_quotation"/>
    </record>

    <template id="x4u_quotation_layout">
        <t t-set="company" t-value="o.company_id"/>
        <div class="header">
            <img t-if="company.x4u_letterhead_header" t-att-src="image_data_uri(company.x4u_letterhead_header)" style="width: 100%;"/>
            <table t-else="" style="width: 100%; border-bottom: 3px solid #FFDE59;">
                <tr>
                    <td style="font-size: 20px; font-weight: bold;" t-out="company.name"/>
                    <td style="text-align: right;"><img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;"/></td>
                </tr>
            </table>
        </div>
        <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div class="footer" style="font-family: Helvetica, Arial, sans-serif;">
            <table style="width: 100%; font-size: 9px; color: #9ca3af; border-top: 1px solid #e5e7eb;">
                <tr>
                    <td style="padding-top: 3px;">This is a formal document generated electronically.</td>
                    <td style="padding-top: 3px; text-align: right;"><span t-out="o.name"/> · Page <span class="page"/> of <span class="topage"/></td>
                </tr>
            </table>
            <img t-if="company.x4u_letterhead_footer" t-att-src="image_data_uri(company.x4u_letterhead_footer)" style="width: 100%; margin-top: 4px;"/>
        </div>
    </template>

    <template id="report_x4u_quotation_document">
        <t t-call="x4u_job_order.x4u_quotation_layout">
            <t t-set="currency" t-value="o.currency_id"/>
            <t t-set="options" t-value="o.x4u_quote_options and o._x4u_option_lines()"/>
            <style>
                .x4u-q { font-family: Helvetica, Arial, sans-serif; color: #1f2937; font-size: 11px; }
                .x4u-q .label { color: #9ca3af; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; }
                .x4u-q .gold { color: #b8860b; font-size: 9px; letter-spacing: 2px; font-weight: bold; text-transform: uppercase; }
                .x4u-q .card { background: #f3f4f6; padding: 12px 16px; vertical-align: top; }
                .x4u-q .card td { padding: 2px 0; vertical-align: top; }
                .x4u-q .card .k { color: #9ca3af; width: 32%; }
                .x4u-q .req { background: #fef9e7; border-left: 4px solid #FFDE59; padding: 10px 14px; margin: 16px 0 18px 0; }
                .x4u-q table.lines { width: 100%; border-collapse: collapse; }
                .x4u-q table.lines th { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #374151; padding: 6px 4px; border-bottom: 2px solid #1e2a3b; }
                .x4u-q table.lines td { padding: 8px 4px; vertical-align: top; border-bottom: 1px solid #e5e7eb; }
                .x4u-q tr.option td { background: #f3f4f6; font-weight: bold; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; padding: 6px 6px; }
                .x4u-q .no { color: #b8860b; font-weight: bold; font-size: 12px; }
                .x4u-q .badge-r { background: #FFDE59; color: #1e2a3b; font-size: 8px; font-weight: bold; letter-spacing: 1.5px; padding: 2px 7px; }
                .x4u-q .badge-a { background: #dbeafe; color: #1e3a8a; font-size: 8px; font-weight: bold; letter-spacing: 1.5px; padding: 2px 7px; }
                .x4u-q .title { font-weight: bold; font-size: 12.5px; color: #1e2a3b; margin: 5px 0 3px 0; }
                .x4u-q .desc { color: #4b5563; font-size: 10.5px; line-height: 1.4; }
                .x4u-q .qty { font-size: 16px; font-weight: bold; text-align: center; }
                .x4u-q .num { text-align: right; white-space: nowrap; }
                .x4u-q .big { font-size: 15px; }
                .x4u-q .amount { font-size: 16px; font-weight: bold; }
                .x4u-q table.sum { width: 100%; border-collapse: collapse; }
                .x4u-q table.sum th { font-size: 8.5px; letter-spacing: 1.5px; color: #6b7280; text-transform: uppercase; padding: 5px; text-align: right; border-bottom: 1px solid #e5e7eb; }
                .x4u-q table.sum td { padding: 7px 5px; border-bottom: 1px solid #e5e7eb; text-align: right; }
                .x4u-q table.sum tr.best td { background: #1e2a3b; color: #ffffff; font-weight: bold; }
            </style>
            <div class="x4u-q">
                <!-- Title and numbers -->
                <table style="width: 100%;">
                    <tr>
                        <td style="vertical-align: top;">
                            <div style="font-size: 34px; font-weight: bold; color: #1e2a3b;" t-out="'Quotation' if o.state in ('draft', 'sent') else 'Sales Order'"/>
                            <div style="width: 50px; height: 4px; background: #FFDE59;"/>
                        </td>
                        <td style="vertical-align: top; text-align: right;">
                            <table style="float: right;">
                                <tr>
                                    <td style="padding: 0 12px; text-align: center;"><div class="label">Quotation No.</div><div style="font-size: 14px; font-weight: bold;" t-out="o.name"/></td>
                                    <td style="padding: 0 12px; text-align: center; border-left: 1px solid #d1d5db;"><div class="label">Date</div><div style="font-size: 14px; font-weight: bold;" t-out="o.date_order and o.date_order.strftime('%d/%m/%Y')"/></td>
                                    <td t-if="o._x4u_validity_days()" style="padding: 0 0 0 12px; text-align: center; border-left: 1px solid #d1d5db;"><div class="label">Valid For</div><div style="font-size: 14px; font-weight: bold;"><t t-out="o._x4u_validity_days()"/> days</div></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <!-- Prepared for / by -->
                <table style="width: 100%; margin-top: 18px; border-collapse: separate; border-spacing: 0;">
                    <tr>
                        <td style="width: 49%; border-left: 3px solid #FFDE59;" class="card">
                            <div class="gold">Prepared For</div>
                            <div style="font-size: 14px; font-weight: bold; margin: 4px 0 8px 0;" t-out="o.partner_id.commercial_partner_id.name"/>
                            <table style="width: 100%;">
                                <tr t-if="o.x4u_attention"><td class="k">Attention</td><td t-out="o.x4u_attention"/></tr>
                                <tr><td class="k">Address</td><td t-out="', '.join(x for x in (o.partner_id.city, o.partner_id.country_id.name) if x) or '-'"/></tr>
                                <tr><td class="k">Contact</td><td t-out="o.partner_id.phone or o.partner_id.mobile or '-'"/></tr>
                                <tr><td class="k">Email</td><td t-out="o.partner_id.email or '-'"/></tr>
                                <tr t-if="o.client_order_ref"><td class="k">Your Ref.</td><td t-out="o.client_order_ref"/></tr>
                            </table>
                        </td>
                        <td style="width: 2%;"/>
                        <td style="width: 49%; border-left: 3px solid #1e2a3b;" class="card">
                            <div class="label">Prepared By</div>
                            <div style="font-size: 14px; font-weight: bold; margin: 4px 0 8px 0;" t-out="o.company_id.name"/>
                            <table style="width: 100%;">
                                <tr t-if="o.user_id"><td class="k">Sales person</td><td t-out="o.user_id.name"/></tr>
                                <tr><td class="k">Contact</td><td t-out="o.user_id.mobile or o.user_id.phone or o.company_id.phone or '-'"/></tr>
                                <tr><td class="k">Email</td><td t-out="o.company_id.email or o.user_id.email or '-'"/></tr>
                                <tr t-if="o.company_id.vat"><td class="k">TRN</td><td t-out="o.company_id.vat"/></tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <!-- Requirement -->
                <div t-if="not is_html_empty(o.x4u_requirement)" class="req" t-field="o.x4u_requirement"/>
                <div t-else="" style="height: 16px;"/>

                <!-- The lines: the column titles once, then one block per item that never splits across
                     pages (inside one long table wkhtmltopdf leaves gaps when it moves a row). -->
                <table class="lines">
                    <tr>
                        <th style="width: 4%; text-align: left;">#</th>
                        <th style="text-align: left;">Description</th>
                        <th style="width: 7%; text-align: center;">Qty</th>
                        <th style="width: 15%; text-align: right;">Unit Price</th>
                        <th style="width: 6%; text-align: right;">VAT</th>
                        <th style="width: 16%; text-align: right;">Amount (<t t-out="currency.name"/>)</th>
                    </tr>
                </table>
                <t t-set="number" t-value="0"/>
                <t t-foreach="o.order_line.sorted('sequence')" t-as="line">
                    <div style="page-break-inside: avoid;">
                        <table class="lines">
                            <t t-if="line.display_type == 'line_section'">
                                <tr class="option"><td colspan="6" t-out="line.name"/></tr>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <tr><td style="width: 4%;"/><td colspan="5" class="desc" t-out="line.name"/></tr>
                            </t>
                            <t t-else="">
                                <t t-set="number" t-value="number + 1"/>
                                <t t-set="title_body" t-value="line._x4u_print_title_body()"/>
                                <tr t-if="options and line in options" class="option">
                                    <td colspan="6">Option <t t-out="line._x4u_option_letter()"/> – <t t-out="line._x4u_option_heading()"/></td>
                                </tr>
                                <tr>
                                    <td class="no" style="width: 4%;" t-out="'%02d' % number"/>
                                    <td>
                                        <span t-if="line.x4u_option_tag == 'recommended'" class="badge-r">RECOMMENDED</span>
                                        <span t-if="line.x4u_option_tag == 'alternative'" class="badge-a">ALTERNATIVE</span>
                                        <div class="title" t-out="title_body[0]"/>
                                        <div class="desc"><t t-foreach="title_body[1]" t-as="text"><t t-out="text"/><br/></t></div>
                                    </td>
                                    <td class="qty" style="width: 7%;"><t t-out="'%g' % line.product_uom_qty"/><div style="font-size: 9px; color: #9ca3af; font-weight: normal;" t-out="line.product_uom.name"/></td>
                                    <t t-if="line._x4u_as_requested()">
                                        <td class="num big" style="width: 15%;">As requested</td>
                                        <td style="width: 6%;"/>
                                        <td class="num amount" style="width: 16%;">As requested</td>
                                    </t>
                                    <t t-else="">
                                        <td class="num big" style="width: 15%;">
                                            <t t-out="'{:,.2f}'.format(line.price_unit)"/>
                                            <div t-if="line.discount" style="font-size: 9px; color: #b8860b;">Disc. <t t-out="'%g' % line.discount"/>%</div>
                                        </td>
                                        <td class="num big" style="width: 6%;" t-out="', '.join('%g%%' % t.amount for t in line.tax_id) or '0%'"/>
                                        <td class="num amount" style="width: 16%;" t-out="'{:,.2f}'.format(line.price_subtotal)"/>
                                    </t>
                                </tr>
                            </t>
                        </table>
                    </div>
                </t>

                <!-- Delivery and Price Summary -->
                <table style="width: 100%; margin-top: 18px; page-break-inside: avoid;">
                    <tr>
                        <td style="width: 44%; vertical-align: top; padding-right: 18px;">
                            <t t-if="o.x4u_delivery_note">
                                <div class="gold" style="margin-bottom: 4px;">Delivery</div>
                                <div style="white-space: pre-line;" t-out="o.x4u_delivery_note"/>
                            </t>
                        </td>
                        <td style="width: 56%; vertical-align: top;">
                            <table class="sum">
                                <t t-if="options and len(options) > 1">
                                    <tr><th style="text-align: left;">Price Summary</th><th>Subtotal</th><th>VAT</th><th>Total (<t t-out="currency.name"/>)</th></tr>
                                    <tr t-foreach="options" t-as="opt" t-att-class="'best' if opt.x4u_option_tag == 'recommended' else ''">
                                        <td style="text-align: left;">Option <t t-out="opt._x4u_option_letter()"/> – <t t-out="opt.product_id.default_code or opt.product_id.name"/> <t t-out="opt.product_id.x4u_engine_brand_id.name or ''"/><t t-if="opt.product_id._x4u_alternator_choice()"> / <t t-out="'4U Power' if opt.product_id._x4u_alternator_choice() in ('4U', 'AQT') else opt.product_id._x4u_alternator_choice()"/></t></td>
                                        <td t-out="'{:,.2f}'.format(opt._x4u_option_total('price_subtotal'))"/>
                                        <td t-out="'{:,.2f}'.format(opt._x4u_option_total('price_tax'))"/>
                                        <td style="font-weight: bold;" t-out="'{:,.2f}'.format(opt._x4u_option_total('price_total'))"/>
                                    </tr>
                                    <tr><td colspan="4" style="border: none; font-size: 8.5px; letter-spacing: 1.5px; color: #9ca3af;">EACH OPTION IS A SEPARATE TOTAL</td></tr>
                                </t>
                                <t t-else="">
                                    <tr><td style="text-align: left;">Subtotal</td><td t-out="'{:,.2f}'.format(o.amount_untaxed)"/></tr>
                                    <tr><td style="text-align: left;">VAT</td><td t-out="'{:,.2f}'.format(o.amount_tax)"/></tr>
                                    <tr class="best"><td style="text-align: left;">Total (<t t-out="currency.name"/>)</td><td t-out="'{:,.2f}'.format(o.amount_total)"/></tr>
                                </t>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Terms & Conditions -->
                <div t-if="not is_html_empty(o.note)" style="page-break-before: always;">
                    <div style="font-size: 20px; font-weight: bold; color: #1e2a3b;">TERMS &amp; CONDITIONS</div>
                    <div style="width: 110px; height: 3px; background: #FFDE59; margin: 4px 0 14px 0;"/>
                    <div t-field="o.note"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_x4u_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-call="x4u_job_order.report_x4u_quotation_document"/>
            </t>
        </t>
    </template>
</odoo>
