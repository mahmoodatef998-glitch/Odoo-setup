        <field name="sequence">200</field>
        <field name="name">opex</field>
        <field name="description">Operating Expenses</field>
        <field name="expression">staff + premises + communication + travel + professional + marketing + vehicles + office + bank_charges + provisions + overhead_absorbed</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
