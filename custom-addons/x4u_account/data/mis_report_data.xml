        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_inventory" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">40</field>
        <field name="name">inventory</field>
        <field name="description">Inventory &amp; Work in Progress</field>
        <field name="expression">bale[103001,103002,103003,103004,103005]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_current_assets" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">50</field>
        <field name="name">current_assets</field>
        <field name="description">Cash, Cheques, Receivables &amp; Stock</field>
        <field name="expression">cash + pdc_received + receivables + inventory</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_payables" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">60</field>
        <field name="name">payables</field>
        <field name="description">Trade Payables</field>
        <field name="expression">-bale[('account_type', '=', 'liability_payable')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_pdc_issued" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">70</field>
        <field name="name">pdc_issued</field>
        <field name="description">PDC Issued (not cleared yet)</field>
        <field name="expression">-bale[201020]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_grni" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">80</field>
        <field name="name">grni</field>
        <field name="description">Goods Received Not Invoiced</field>
        <field name="expression">-bale[201021]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_current_liabilities" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">90</field>
        <field name="name">current_liabilities</field>
        <field name="description">Payables &amp; Cheques Issued</field>
        <field name="expression">payables + pdc_issued + grni</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_working_capital" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">100</field>
        <field name="name">working_capital</field>
        <field name="description">Working Capital</field>
        <field name="expression">current_assets - current_liabilities</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_cash_after_pdc" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">110</field>
        <field name="name">cash_after_pdc</field>
        <field name="description">Cash After All PDCs Clear</field>
        <field name="expression">cash + pdc_received - pdc_issued</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
</odoo>
