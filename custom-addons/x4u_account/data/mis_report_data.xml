<?xml version="1.0" encoding="utf-8"?>
<!-- Spec x4u_account §14: the 4U groups on the l10n_ae codes. When the account tree changes,
     change the codes here; the Accountant copies a report (Duplicate) to change it on screen. -->
<odoo>
    <record id="mis_report_x4u_pl" model="mis.report">
        <field name="name">4U Management P&amp;L</field>
        <field name="description">Revenue by line, gross margin, operating expenses by group, EBITDA, net profit</field>
        <field name="style_id" ref="mis_template_financial_report.style_default"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_generators" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">10</field>
        <field name="name">rev_generators</field>
        <field name="description">Generator Sales</field>
        <field name="expression">-balp[500001]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_parts" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">20</field>
        <field name="name">rev_parts</field>
        <field name="description">Spare Parts Sales</field>
        <field name="expression">-balp[500015]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_services" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">30</field>
        <field name="name">rev_services</field>
        <field name="description">Service Income</field>
        <field name="expression">-balp[500008]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_other" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">40</field>
        <field name="name">rev_other</field>
        <field name="description">Other Operating Revenue</field>
        <field name="expression">-balp[500002,500003,500004,500005,500006,500007]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">50</field>
        <field name="name">revenue</field>
        <field name="description">Revenue</field>
        <field name="expression">rev_generators + rev_parts + rev_services + rev_other</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_cogs" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">60</field>
        <field name="name">cogs</field>
        <field name="description">Cost of Sales</field>
        <field name="expression">balp[('account_type', '=', 'expense_direct_cost')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_gross_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">70</field>
        <field name="name">gross_profit</field>
        <field name="description">Gross Profit</field>
        <field name="expression">revenue - cogs</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_gross_margin" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">80</field>
        <field name="name">gross_margin</field>
        <field name="description">Gross Margin %</field>
        <field name="expression">gross_profit / revenue if revenue else AccountingNone</field>
        <field name="type">pct</field>
        <field name="compare_method">none</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_staff" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">90</field>
