<?xml version="1.0" encoding="utf-8"?>
<!-- Spec x4u_account §14, §19: the 4U groups on the Focus account tree codes (focus_chart.py). When the tree changes,
     change the codes here; the Accountant copies a report (Duplicate) to change it on screen. -->
<odoo>
    <record id="mis_report_x4u_pl" model="mis.report">
        <field name="name">4U Management P&amp;L</field>
        <field name="description">Revenue by line, gross margin, expenses in three groups (O / S / G), other expenses and tax (X), net profit</field>
        <field name="style_id" ref="mis_template_financial_report.style_default"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_generators" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">10</field>
        <field name="name">rev_generators</field>
        <field name="description">Generator Sales</field>
        <field name="expression">-balp[410002]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_parts" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">20</field>
        <field name="name">rev_parts</field>
        <field name="description">Spare Parts Sales</field>
        <field name="expression">-balp[410009]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_services" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">30</field>
        <field name="name">rev_services</field>
        <field name="description">Service Income</field>
        <field name="expression">-balp[410003]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_rev_other" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">40</field>
        <field name="name">rev_other</field>
        <field name="description">Other Operating Revenue</field>
        <field name="expression">-balp[410001,410004,410006,410008,410011]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">50</field>
        <field name="name">revenue</field>
        <field name="description">Revenue</field>
        <field name="expression">rev_generators + rev_parts + rev_services + rev_other</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_cogs" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">60</field>
        <field name="name">cogs</field>
        <field name="description">Cost of Sales</field>
        <field name="expression">balp[('account_type', '=', 'expense_direct_cost')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_gross_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">70</field>
        <field name="name">gross_profit</field>
        <field name="description">Gross Profit</field>
        <field name="expression">revenue - cogs</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_gross_margin" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">80</field>
        <field name="name">gross_margin</field>
        <field name="description">Gross Margin %</field>
        <field name="expression">gross_profit / revenue if revenue else AccountingNone</field>
        <field name="type">pct</field>
        <field name="compare_method">none</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <!-- The accounting team, 2026-11-27: the expenses in three groups (O / S / G) by the P&L Group
         of each account (focus_chart.PL_GROUPS, changed by the Accountant on the account), then
         Other Expenses and Corporate Tax (X). -->
    <record id="mis_report_x4u_pl_kpi_operating" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">90</field>
        <field name="name">exp_operating</field>
        <field name="description">Operating Expenses (O)</field>
        <field name="expression">balp[('x4u_pl_group', '=', 'operating')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_selling" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">100</field>
        <field name="name">exp_selling</field>
        <field name="description">Selling &amp; Marketing Expenses (S)</field>
        <field name="expression">balp[('x4u_pl_group', '=', 'selling')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_admin" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">110</field>
        <field name="name">exp_admin</field>
        <field name="description">General &amp; Administrative Expenses (G)</field>
        <field name="expression">balp[('x4u_pl_group', '=', 'admin')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_opex" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">200</field>
        <field name="name">opex</field>
        <field name="description">Total Expenses</field>
        <field name="expression">exp_operating + exp_selling + exp_admin</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_operating_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">230</field>
        <field name="name">operating_profit</field>
        <field name="description">Operating Profit</field>
        <field name="expression">gross_profit - opex</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_other_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">240</field>
        <field name="name">other_income</field>
        <field name="description">Other Income</field>
        <field name="expression">-balp[410005,410007,410010,410012,410013,410014]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_other_expenses" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">250</field>
        <field name="name">other_expenses</field>
        <field name="description">Other Expenses (X)</field>
        <field name="expression">balp[('x4u_pl_group', '=', 'other')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_profit_before_tax" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">260</field>
        <field name="name">profit_before_tax</field>
        <field name="description">Profit Before Tax</field>
        <field name="expression">operating_profit + other_income - other_expenses</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_corporate_tax" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">270</field>
        <field name="name">corporate_tax</field>
        <field name="description">Corporate Tax</field>
        <field name="expression">balp[('x4u_pl_group', '=', 'tax')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_net_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">280</field>
        <field name="name">net_profit</field>
        <field name="description">Net Profit</field>
        <field name="expression">profit_before_tax - corporate_tax</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_net_margin" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">290</field>
        <field name="name">net_margin</field>
        <field name="description">Net Margin %</field>
        <field name="expression">net_profit / revenue if revenue else AccountingNone</field>
        <field name="type">pct</field>
        <field name="compare_method">none</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_pl_kpi_not_mapped" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_pl"/>
        <field name="sequence">300</field>
        <field name="name">not_mapped</field>
        <field name="description">Accounts Not in This Report (must be 0)</field>
        <field name="expression">-balp[('account_type', 'in', ('income', 'income_other'))] - balp[('account_type', 'in', ('expense', 'expense_depreciation', 'expense_direct_cost'))] - net_profit</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash" model="mis.report">
        <field name="name">4U Cash &amp; Working Capital</field>
        <field name="description">Cash, cheques in hand and issued, receivables, stock and payables at a date</field>
        <field name="style_id" ref="mis_template_financial_report.style_default"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_cash" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">10</field>
        <field name="name">cash</field>
        <field name="description">Cash &amp; Bank</field>
        <field name="expression">bale[('account_type', '=', 'asset_cash')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_pdc_received" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">20</field>
        <field name="name">pdc_received</field>
        <field name="description">PDC Received (cheques in hand)</field>
        <field name="expression">bale[132001]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_receivables" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">30</field>
        <field name="name">receivables</field>
        <field name="description">Trade Receivables</field>
        <field name="expression">bale[('account_type', '=', 'asset_receivable')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_inventory" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">40</field>
        <field name="name">inventory</field>
        <field name="description">Inventory &amp; Work in Progress</field>
        <field name="expression">bale[134%]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_current_assets" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">50</field>
        <field name="name">current_assets</field>
        <field name="description">Cash, Cheques, Receivables &amp; Stock</field>
        <field name="expression">cash + pdc_received + receivables + inventory</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_payables" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">60</field>
        <field name="name">payables</field>
        <field name="description">Trade Payables</field>
        <field name="expression">-bale[('account_type', '=', 'liability_payable')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_pdc_issued" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">70</field>
        <field name="name">pdc_issued</field>
        <field name="description">PDC Issued (not cleared yet)</field>
        <field name="expression">-bale[214%]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_grni" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">80</field>
        <field name="name">grni</field>
        <field name="description">Goods Received Not Invoiced</field>
        <field name="expression">-bale[212006]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_details"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_current_liabilities" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">90</field>
        <field name="name">current_liabilities</field>
        <field name="description">Payables &amp; Cheques Issued</field>
        <field name="expression">payables + pdc_issued + grni</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_working_capital" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">100</field>
        <field name="name">working_capital</field>
        <field name="description">Working Capital</field>
        <field name="expression">current_assets - current_liabilities</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
    <record id="mis_report_x4u_cash_kpi_cash_after_pdc" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_x4u_cash"/>
        <field name="sequence">110</field>
        <field name="name">cash_after_pdc</field>
        <field name="description">Cash After All PDCs Clear</field>
        <field name="expression">cash + pdc_received - pdc_issued</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="style_id" ref="mis_template_financial_report.style_header"/>
    </record>
</odoo>
