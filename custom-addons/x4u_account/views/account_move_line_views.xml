<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spec §22 G1: Journal Items (and the bank / petty cash lines opened from it) show the Counterpart. -->
    <record id="view_move_line_tree_x4u_counterpart" model="ir.ui.view">
        <field name="name">account.move.line.list.x4u.counterpart</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="x4u_counterpart" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
