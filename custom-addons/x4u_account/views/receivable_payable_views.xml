<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spec §5: Receivables & Payables. The due lists reuse OCA account_due_list (+ days overdue). -->
    <record id="x4u_customer_due_action" model="ir.actions.act_window">
        <field name="name">Customer Due List</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('account_due_list.view_payments_tree')}),
            Command.create({'view_mode': 'pivot', 'view_id': ref('account_due_list.view_payments_pivot')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('account_due_list.view_payments_graph')})]"/>
        <field name="search_view_id" ref="account_due_list.view_payments_filter"/>
        <field name="domain">[('account_id.account_type', '=', 'asset_receivable'), ('parent_state', '=', 'posted'),
            ('reconciled', '=', False), ('balance', '!=', 0)]</field>
        <!-- The accounting team, 2026-11-27: a line per customer with its total, expanding to its invoices. -->
        <field name="context">{'group_by': ['partner_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer amounts due</p>
            <p>Every open customer invoice and unapplied payment, with its due date and days overdue.</p>
        </field>
    </record>

    <record id="x4u_vendor_due_action" model="ir.actions.act_window">
        <field name="name">Vendor Due List</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('account_due_list.view_payments_tree')}),
            Command.create({'view_mode': 'pivot', 'view_id': ref('account_due_list.view_payments_pivot')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('account_due_list.view_payments_graph')})]"/>
        <field name="search_view_id" ref="account_due_list.view_payments_filter"/>
        <field name="domain">[('account_id.account_type', '=', 'liability_payable'), ('parent_state', '=', 'posted'),
            ('reconciled', '=', False), ('balance', '!=', 0)]</field>
        <!-- The accounting team, 2026-11-27: a line per vendor with its total, expanding to its invoices. -->
        <field name="context">{'group_by': ['partner_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing due to vendors</p>
            <p>Every open vendor invoice and unapplied payment, with its due date and days overdue.</p>
        </field>
    </record>

    <!-- Balances per partner; select partners, then Action › Partner Outstanding / Activity Statement. -->
    <record id="x4u_partner_balance_view_list" model="ir.ui.view">
        <field name="name">res.partner.list.x4u.balance</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Balances" create="0">
                <field name="display_name" string="Partner"/>
                <field name="vat" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="credit" string="Receivable" widget="monetary"/>
                <field name="debit" string="Payable" widget="monetary"/>
                <field name="credit_limit" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="x4u_customer_balance_action" model="ir.actions.act_window">
        <field name="name">Customer Balances</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('credit', '>', 0)]</field>
        <field name="context">{'res_partner_search_mode': 'customer', 'create': False}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('x4u_partner_balance_view_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer owes us anything</p>
            <p>Select customers, then <b>Action › Partner Outstanding Statement</b> to send them their statement.</p>
        </field>
    </record>

    <record id="x4u_vendor_balance_action" model="ir.actions.act_window">
        <field name="name">Vendor Balances</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('debit', '>', 0)]</field>
        <field name="context">{'res_partner_search_mode': 'supplier', 'create': False}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('x4u_partner_balance_view_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">We owe no vendor anything</p>
            <p>Select vendors, then <b>Action › Partner Outstanding Statement</b> to check their balance.</p>
        </field>
    </record>

    <!-- The accounting team, 2026-11-27: each customer / vendor on one line with its balance; a click
         opens its invoices, payments and entries (a grouped partner ledger). -->
    <record id="x4u_customer_accounts_action" model="ir.actions.act_window">
        <field name="name">Customer Ledger</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <!-- With the advances not invoiced yet (Advances from Customers / to Suppliers). -->
        <field name="domain">['|', ('account_id.account_type', '=', 'asset_receivable'), ('account_id.x4u_partner_advance', '=', 'customer'),
            ('parent_state', '=', 'posted')]</field>
        <field name="context">{'group_by': ['partner_id'], 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer entries yet</p>
            <p>A line per customer with its balance; click it for its invoices and payments.</p>
        </field>
    </record>
    <record id="x4u_vendor_accounts_action" model="ir.actions.act_window">
        <field name="name">Vendor Ledger</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <!-- With the advances not invoiced yet (Advances from Customers / to Suppliers). -->
        <field name="domain">['|', ('account_id.account_type', '=', 'liability_payable'), ('account_id.x4u_partner_advance', '=', 'vendor'),
            ('parent_state', '=', 'posted')]</field>
        <field name="context">{'group_by': ['partner_id'], 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No vendor entries yet</p>
            <p>A line per vendor with its balance; click it for its bills and payments.</p>
        </field>
    </record>
    <!-- The accounting team, 2026-11-27: the general ledger grouped by account, a click opens its entries. -->
    <record id="x4u_ledger_by_account_action" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="domain">[('parent_state', '=', 'posted')]</field>
        <!-- The current year: an income or expense account is read by year (2026-11-27). -->
        <field name="context">{'group_by': ['account_id'], 'create': False, 'search_default_x4u_this_year': 1}</field>
    </record>

    <!-- The accounting team, 2026-11-27: the Partner Ledger grouped per partner (customers, vendors and
         their advances), each with its balance; a click opens its entries. No date filter: the total is
         what each partner owes or is owed today. -->
    <record id="x4u_partner_ledger_action" model="ir.actions.act_window">
        <field name="name">Partner Ledger</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="domain">['|', ('account_id.account_type', 'in', ('asset_receivable', 'liability_payable')),
            ('account_id.x4u_partner_advance', '!=', False), ('parent_state', '=', 'posted')]</field>
        <field name="context">{'group_by': ['partner_id'], 'create': False}</field>
    </record>

    <record id="view_account_move_line_filter_x4u_year" model="ir.ui.view">
        <field name="name">account.move.line.search.x4u.year</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <filter name="date" position="before">
                <!-- The 4U fiscal year is the calendar year. -->
                <filter string="This Year" name="x4u_this_year"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01')), ('date', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
            </filter>
        </field>
    </record>
</odoo>
