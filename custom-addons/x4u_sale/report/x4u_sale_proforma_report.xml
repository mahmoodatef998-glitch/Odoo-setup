<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spec §6 S6: the whole order and its payment schedule, not a tax invoice. The letterhead
         comes from the company layout (x4u_reports later). -->
    <record id="action_report_proforma" model="ir.actions.report">
        <field name="name">Proforma Invoice</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x4u_sale.report_proforma</field>
        <field name="report_file">x4u_sale.report_proforma</field>
        <field name="print_report_name">'PI %s' % object.name</field>
        <field name="binding_model_id" ref="model_x4u_sale_proforma"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_proforma_document">
        <t t-call="web.external_layout">
            <t t-set="order" t-value="o.order_id"/>
            <t t-set="address">
                <div t-field="order.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <p t-if="order.partner_invoice_id.vat">TRN: <span t-field="order.partner_invoice_id.vat"/></p>
            </t>
            <div class="page">
                <h2>PROFORMA INVOICE <span t-field="o.name"/></h2>
                <p><strong>This is not a tax invoice.</strong></p>
                <div class="row mt-4 mb-4">
                    <div class="col-3">
                        <strong>Date</strong>
                        <div t-field="o.date"/>
                    </div>
                    <div class="col-3">
                        <strong>Sales Order</strong>
                        <div t-field="order.name"/>
                    </div>
                    <div class="col-3" t-if="order.client_order_ref">
                        <strong>LPO Number</strong>
                        <div t-field="order.client_order_ref"/>
                    </div>
                    <div class="col-3" t-if="order.x4u_lpo_date">
                        <strong>LPO Date</strong>
                        <div t-field="order.x4u_lpo_date"/>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="order.order_line.filtered(lambda line: not line.display_type and not line.is_downpayment)" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Total before VAT</td>
                                <td class="text-end"><span t-field="order.amount_untaxed"/></td>
                            </tr>
                            <tr>
                                <td>VAT</td>
                                <td class="text-end"><span t-field="order.amount_tax"/></td>
                            </tr>
                            <tr class="fw-bold">
                                <td>Total</td>
                                <td class="text-end"><span t-field="order.amount_total"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <h5 class="mt-3">Payment schedule</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th class="text-start">#</th>
                            <th class="text-start">When</th>
                            <th class="text-end">%</th>
                            <th class="text-end">Before VAT</th>
                            <th class="text-end">VAT</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Due Date</th>
                            <th class="text-end">Paid</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.schedule_ids" t-as="payment">
                            <td><t t-out="payment_index + 1"/></td>
                            <td>
                                <span t-field="payment.trigger"/>
                                <t t-if="payment.trigger == 'invoice' and payment.days"> <t t-out="payment.days"/> days</t>
                            </td>
                            <td class="text-end"><t t-out="'%g' % payment.percent"/>%</td>
                            <td class="text-end"><span t-field="payment.amount_untaxed"/></td>
                            <td class="text-end"><span t-field="payment.amount_tax"/></td>
                            <td class="text-end"><span t-field="payment.amount_total"/></td>
                            <td class="text-end"><span t-if="payment.date_due" t-field="payment.date_due"/></td>
                            <td class="text-end"><span t-field="payment.amount_paid"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end" t-if="o.state == 'open' and o.amount_due_now">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr t-if="o.amount_paid">
                                <td>Received so far</td>
                                <td class="text-end"><span t-field="o.amount_paid"/></td>
                            </tr>
                            <tr class="fw-bold">
                                <td>Amount due now<t t-if="o.next_payment"> (payment <t t-out="o.next_payment"/>)</t></td>
                                <td class="text-end"><span t-field="o.amount_due_now"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <p t-if="order.payment_term_id">Payment terms: <span t-field="order.payment_term_id.name"/></p>
                <div t-if="o.x4u_bank_accounts()" class="mt-3">
                    <strong>Bank details</strong>
                    <div t-foreach="o.x4u_bank_accounts()" t-as="bank">
                        <span t-field="bank.bank_id.name"/>
                        <span t-if="bank.acc_holder_name"> · <span t-field="bank.acc_holder_name"/></span>
                        · <span t-field="bank.acc_number"/>
                        <span t-if="bank.bank_id.bic"> · SWIFT <span t-field="bank.bank_id.bic"/></span>
                    </div>
                </div>
                <p class="mt-3">Please quote <strong t-field="o.name"/> with your payment. The tax invoice is issued by our accounts department.</p>
            </div>
        </t>
    </template>

    <template id="report_proforma">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="x4u_sale.report_proforma_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
