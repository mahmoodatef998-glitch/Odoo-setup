<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x4u_sale_proforma_view_list" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.list</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="arch" type="xml">
            <list string="Proforma Invoices" create="0" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="client_order_ref" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_paid" sum="Paid"/>
                <field name="next_payment" optional="show"/>
                <field name="amount_due_now" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'open'" decoration-success="state in ('paid', 'invoiced')"/>
            </list>
        </field>
    </record>

    <record id="x4u_sale_proforma_view_form" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.form</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="arch" type="xml">
            <form string="Proforma Invoice" create="0">
                <header>
                    <button name="action_register_payment" type="object" string="Register Payment" class="btn-primary"
                            groups="account.group_account_invoice" invisible="state != 'open'"/>
                    <button name="action_create_tax_invoice" type="object" string="Create Tax Invoice"
                            groups="account.group_account_invoice" invisible="state not in ('open', 'paid')"
                            confirm="Create the tax invoice of the whole order? Confirming it applies the payments of this PI."/>
                    <button name="action_send" type="object" string="Send by Email"
                            groups="account.group_account_invoice" invisible="state != 'open'"/>
                    <button name="%(x4u_sale.action_report_proforma)d" type="action" string="Print" invisible="state == 'cancel'"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="account.group_account_invoice"
                            invisible="state != 'open' or amount_paid" confirm="Cancel this PI?"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,paid,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money"
                                groups="account.group_account_invoice,account.group_account_readonly" invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Paid" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Invoiced" invisible="state != 'invoiced'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="client_order_ref"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="next_payment" invisible="not next_payment or state != 'open'"/>
                            <field name="amount_due_now" invisible="state != 'open'" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="schedule_ids" readonly="state in ('invoiced', 'cancel')">
                        <list editable="bottom" create="0" delete="0">
                            <field name="percent" readonly="1"/>
                            <field name="trigger" readonly="1"/>
                            <field name="days" readonly="1" invisible="trigger != 'invoice'"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount_untaxed" optional="hide"/>
                            <field name="amount_tax" optional="hide"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'partial'"/>
                            <field name="date_due" readonly="state == 'paid'"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                        <field name="amount_paid"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="x4u_sale_proforma_view_search" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.search</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="arch" type="xml">
            <search string="Proforma Invoices">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="client_order_ref"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="x4u_sale_proforma_action" model="ir.actions.act_window">
        <field name="name">Proforma Invoices</field>
        <field name="res_model">x4u.sale.proforma</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="x4u_sale_proforma_view_search"/>
        <field name="context">{'create': False, 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No PI yet</p>
            <p>On a confirmed sales order: PO Matches Quotation, then Create PI.</p>
        </field>
    </record>

    <record id="x4u_sale_po_mismatch_view_form" model="ir.ui.view">
        <field name="name">x4u.sale.po.mismatch.form</field>
        <field name="model">x4u.sale.po.mismatch</field>
        <field name="arch" type="xml">
            <form string="Customer PO Doesn't Match">
                <group>
                    <field name="order_id" force_save="1"/>
                    <field name="reason" placeholder="e.g. the PO says 400 kVA, the quotation 500 kVA"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Send to the Salesperson" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Accounting › Customers: the confirmed orders to check, to make the PI of, and to invoice. -->
    <record id="x4u_sale_order_accounting_action" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale.view_order_tree"/>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="context">{'create': False}</field>
    </record>
    <!-- Accounting › Customers › Sales Section (the user, 2026-11-07). -->
    <menuitem id="menu_x4u_sale_order_accounting" name="Sales Section" parent="account.menu_finance_receivables"
              action="x4u_sale_order_accounting_action" sequence="10" groups="account.group_account_invoice"/>
    <menuitem id="menu_x4u_sale_proforma_accounting" parent="account.menu_finance_receivables"
              action="x4u_sale_proforma_action" sequence="11" groups="account.group_account_invoice,account.group_account_readonly"/>
</odoo>
