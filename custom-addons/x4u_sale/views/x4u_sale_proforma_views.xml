<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x4u_sale_proforma_view_list" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.list</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="arch" type="xml">
            <list string="Proformas" create="0" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="date"/>
                <field name="date_due" widget="remaining_days" invisible="state in ('paid', 'cancel')"/>
                <field name="percent" string="%"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_paid" sum="Paid" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'partial'" decoration-info="state == 'not_paid'"/>
            </list>
        </field>
    </record>

    <record id="x4u_sale_proforma_view_form" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.form</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="arch" type="xml">
            <form string="Proforma" create="0">
                <header>
                    <button name="action_register_payment" type="object" string="Register Payment" class="btn-primary"
                            groups="account.group_account_invoice" invisible="state not in ('not_paid', 'partial')"/>
                    <button name="action_send" type="object" string="Send by Email"
                            groups="account.group_account_invoice" invisible="state == 'cancel'"/>
                    <button name="%(x4u_sale.action_report_proforma)d" type="action" string="Print"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="account.group_account_invoice"
                            invisible="state != 'not_paid'" confirm="Cancel this proforma?"/>
                    <field name="state" widget="statusbar" statusbar_visible="not_paid,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money"
                                groups="account.group_account_invoice,account.group_account_readonly" invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Paid" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="date_due" readonly="state in ('paid', 'cancel')"/>
                            <label for="percent"/>
                            <div><field name="percent" class="oe_inline"/> %</div>
                        </group>
                    </group>
                    <group class="oe_subtotal_footer">
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                        <field name="amount_paid"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="x4u_sale_proforma_view_search" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.search</field>
        <field name="model">x4u.sale.proforma</field>
        <field name="arch" type="xml">
            <search string="Proformas">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter name="open" string="Not Paid" domain="[('state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', 'in', ('not_paid', 'partial')), ('date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_order" string="Sales Order" context="{'group_by': 'order_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="x4u_sale_proforma_action" model="ir.actions.act_window">
        <field name="name">Proformas</field>
        <field name="res_model">x4u.sale.proforma</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="x4u_sale_proforma_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No proforma yet</p>
            <p>The Accountant asks for an advance from a confirmed sales order: button Proforma.</p>
        </field>
    </record>

    <record id="x4u_sale_proforma_wizard_view_form" model="ir.ui.view">
        <field name="name">x4u.sale.proforma.wizard.form</field>
        <field name="model">x4u.sale.proforma.wizard</field>
        <field name="arch" type="xml">
            <form string="Issue a Proforma">
                <group>
                    <group>
                        <field name="order_id" force_save="1"/>
                        <field name="advance_type" widget="radio"/>
                        <label for="percent" invisible="advance_type != 'percentage'"/>
                        <div invisible="advance_type != 'percentage'">
                            <field name="percent" class="oe_inline"/> %
                        </div>
                        <field name="fixed_amount" invisible="advance_type != 'fixed'"/>
                        <field name="date_due"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="order_amount_total"/>
                        <field name="requested_amount"/>
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Issue Proforma" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Accounting › Customers: the confirmed orders to ask advances for and to invoice. -->
    <record id="x4u_sale_order_accounting_action" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale.view_order_tree"/>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="context">{'create': False}</field>
    </record>
    <menuitem id="menu_x4u_sale_order_accounting" parent="account.menu_finance_receivables"
              action="x4u_sale_order_accounting_action" sequence="10" groups="account.group_account_invoice"/>
    <menuitem id="menu_x4u_sale_proforma_accounting" parent="account.menu_finance_receivables"
              action="x4u_sale_proforma_action" sequence="11" groups="account.group_account_invoice"/>
    <menuitem id="menu_x4u_sale_proforma_sales" parent="sale.sale_order_menu"
              action="x4u_sale_proforma_action" sequence="3" groups="sales_team.group_sale_salesman"/>
</odoo>
