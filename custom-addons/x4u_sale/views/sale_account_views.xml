<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales order: the customer PO (§3), the payment schedule (S2 / S3), the Accountant's
         PO check and PI (S5 / S6), what came in (S9); invoices by Accounting only (§7). -->
    <record id="view_order_form_x4u_sale" model="ir.ui.view">
        <field name="name">sale.order.form.x4u.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Spec v0.7 / v0.8: the Salesperson makes the PI and sends the PO and the first payment,
                 the Accountant checks the PO, records the payment and confirms (O2-O5, Q1-Q5). -->
            <!-- The quotation goes to the customer first (Send by Email, Preview, Print), as many times as
                 it changes; Send to Accountant comes once the customer agreed and paid: after the
                 sending buttons, blue only once the quotation was sent (the user, 2026-11-14). -->
            <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                <field name="x4u_proforma_id" invisible="1"/>
                <!-- The user, 2026-11-26: no Create PI button - Send to Accountant makes the PI. -->
                <field name="x4u_stage" invisible="1"/>
                <!-- v0.9 C1-C6: Confirm Quotation (the customer said yes), then the PI, the customer PO,
                     the payment and the documents in any order, then Send to Accountant. -->
                <button name="action_x4u_accept" type="object" string="Confirm Quotation" class="btn-primary"
                        groups="sales_team.group_sale_salesman" invisible="x4u_stage != 'quotation'"
                        help="The customer accepted: the prices and quantities are locked. Nothing is made, bought or posted yet."/>
                <button name="action_x4u_create_proforma" type="object" string="Create PI"
                        groups="sales_team.group_sale_salesman"
                        invisible="x4u_stage not in ('accepted', 'returned') or x4u_proforma_id"/>
                <!-- The user, 2026-11-26 (fewer steps): Send to Accountant makes the PI if there is none. -->
                <button name="action_x4u_send_to_accountant" type="object" string="Send to Accountant" class="btn-primary"
                        groups="sales_team.group_sale_salesman"
                        invisible="x4u_stage not in ('accepted', 'returned')"/>
                <button name="action_x4u_back_to_quotation" type="object" string="Back to Quotation"
                        groups="sales_team.group_sale_salesman" invisible="x4u_stage not in ('accepted', 'returned')"
                        confirm="Back to quotation: the PI is cancelled and the prices and quantities can be changed. Continue?"/>
            </xpath>
            <!-- v0.9 C1: one bar for everybody: Quotation, Accepted, With Accountant, Confirmed. -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="x4u_stage" widget="statusbar" statusbar_visible="quotation,accepted,with_accountant,confirmed"/>
            </xpath>
            <!-- Q8: Odoo's own "Send PRO-FORMA Invoice" sends the quotation as a pro-forma; the 4U PI is
                 the one PI of the order (Create PI): Odoo's stays hidden, so there is one kind of PI. -->
            <xpath expr="//button[@id='send_proforma_primary']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//button[@id='send_proforma']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="before">
                <!-- The user, 2026-11-26 (fewer steps): PO Matches, the payment and Confirm in one screen. -->
                <button name="action_x4u_check_confirm" type="object" string="Check &amp; Confirm" class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="state not in ('draft', 'sent') or x4u_po_check != 'to_check'"/>
                <button name="action_x4u_po_match" type="object" string="PO Matches Quotation"
                        groups="account.group_account_invoice"
                        invisible="state == 'cancel' or x4u_po_check != 'to_check'"/>
                <button name="action_x4u_po_mismatch" type="object" string="PO Doesn't Match"
                        groups="account.group_account_invoice"
                        invisible="state not in ('draft', 'sent') or x4u_po_check not in ('to_check', 'match')"/>
                <button name="action_x4u_register_payment" type="object" string="Register Payment"
                        groups="account.group_account_invoice"
                        invisible="state == 'cancel' or (state != 'sale' and x4u_po_check not in ('to_check', 'match')) or (state == 'sale' and not x4u_amount_remaining)"/>
                <button name="action_x4u_create_tax_invoice" type="object" string="Create Tax Invoice"
                        groups="account.group_account_invoice" invisible="state != 'sale' or invoice_status != 'to invoice'"
                        confirm="Create and confirm the tax invoice of the whole order? It applies the payments received and delivers the generators still in stock."/>
            </xpath>
            <!-- O5: only the Accountant confirms, after PO Matches. -->
            <xpath expr="(//button[@name='action_confirm'])[1]" position="attributes">
                <attribute name="groups">account.group_account_invoice</attribute>
                <attribute name="invisible">state != 'sent' or x4u_po_check != 'match'</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_confirm'])[2]" position="attributes">
                <attribute name="groups">account.group_account_invoice</attribute>
                <attribute name="invisible">state != 'draft' or x4u_po_check != 'match'</attribute>
                <attribute name="class">btn-primary</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="groups">account.group_account_invoice</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="groups">account.group_account_invoice</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_x4u_view_proformas" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not x4u_proforma_count">
                    <field name="x4u_proforma_count" widget="statinfo" string="PI"/>
                </button>
                <button name="action_x4u_view_advances" type="object" class="oe_stat_button" icon="fa-money"
                        groups="account.group_account_invoice,account.group_account_readonly" invisible="not x4u_advance_count">
                    <field name="x4u_advance_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
            <!-- Spec v0.7.1 O11: who made the quotation, at the top next to the customer (Odoo fills it
                 with the user who creates it; it can be changed). -->
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <xpath expr="//page[@name='other_information']//field[@name='user_id']" position="move"/>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">locked or x4u_amount_advance or x4u_po_check in ('to_check', 'match') or x4u_stage in ('accepted', 'returned')</attribute>
            </xpath>
            <!-- v0.9 C2: accepted by the customer: the product, quantity, price, discount and taxes read
                 only (Back to Quotation opens them); the Supply stays open. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
                <attribute name="readonly">(id and not product_updatable) or parent.x4u_stage in ('accepted', 'returned', 'with_accountant')</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">is_downpayment or parent.x4u_stage in ('accepted', 'returned', 'with_accountant')</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or parent.x4u_stage in ('accepted', 'returned', 'with_accountant')</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or is_downpayment or parent.x4u_stage in ('accepted', 'returned', 'with_accountant')</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="readonly">parent.x4u_stage in ('accepted', 'returned', 'with_accountant')</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="after">
                <xpath expr="//page[@name='other_information']//field[@name='client_order_ref']" position="move"/>
                <field name="x4u_lpo_date" readonly="state == 'sale' or x4u_po_check in ('to_check', 'match')"/>
                <field name="x4u_lpo_attachment_ids" widget="many2many_binary"
                       readonly="state == 'sale' or x4u_po_check in ('to_check', 'match')"/>
                <field name="x4u_advance_due" invisible="1"/>
                <field name="x4u_proforma_id" string="PI" invisible="not x4u_proforma_id"/>
                <field name="x4u_payment_proof_ids" widget="many2many_binary" readonly="state == 'cancel'"/>
                <field name="x4u_po_check" widget="badge" invisible="not x4u_po_check"
                       decoration-success="x4u_po_check == 'match'" decoration-warning="x4u_po_check == 'to_check'"
                       decoration-danger="x4u_po_check == 'mismatch'"/>
                <field name="x4u_po_mismatch_reason" invisible="x4u_po_check != 'mismatch'"/>
                <field name="x4u_checklist_html" invisible="x4u_stage not in ('accepted', 'returned', 'with_accountant')"/>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="readonly">state == 'sale' or x4u_po_check in ('to_check', 'match')</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <!-- v0.9 C4: what this customer sends with every order, ticked on the customer. -->
                <page string="Documents" name="x4u_documents" invisible="not x4u_document_ids">
                    <field name="x4u_document_ids" readonly="state in ('sale', 'cancel') or x4u_po_check in ('to_check', 'match')">
                        <list editable="bottom" create="0" delete="0">
                            <field name="type_id" readonly="1"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="done" widget="boolean"/>
                        </list>
                    </field>
                </page>
                <page string="Payment Schedule" name="x4u_payment_schedule">
                    <field name="x4u_schedule_custom" invisible="1"/>
                    <field name="x4u_schedule_ids"
                           readonly="not x4u_schedule_custom or locked or x4u_amount_advance or x4u_po_check in ('to_check', 'match')">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="percent"/>
                            <field name="trigger"/>
                            <field name="days" invisible="trigger != 'invoice'"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="amount_paid" column_invisible="parent.state != 'sale'"/>
                            <field name="state" widget="badge" column_invisible="parent.state != 'sale'"
                                   decoration-success="state == 'paid'" decoration-warning="state == 'partial'"/>
                            <field name="date_due" readonly="1" optional="hide"/>
                        </list>
                    </field>
                    <div class="text-muted" invisible="x4u_schedule_custom">
                        The schedule comes from the payment terms. Choose Custom in Payment Terms to write your own.
                    </div>
                    <!-- S12: the Accountant's due dates, in a list of their own (a second list of these
                         lines on the form broke saving a new quotation, 2026-11-14). -->
                    <button name="action_x4u_due_dates" type="object" string="Set Due Dates" class="btn-link"
                            icon="fa-calendar" groups="account.group_account_invoice" invisible="state != 'sale'"/>
                    <div class="text-danger" invisible="not x4u_schedule_custom or x4u_schedule_percent == 100">
                        Total <field name="x4u_schedule_percent" class="oe_inline"/>%: the payments must add up to 100%.
                    </div>
                </page>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="x4u_amount_advance" invisible="not x4u_amount_advance"/>
                <field name="x4u_amount_remaining" invisible="state != 'sale' and not x4u_amount_advance"/>
            </xpath>
        </field>
    </record>

    <!-- v0.8 Q1: the PI of each quotation and order, in the lists -->
    <record id="sale_order_tree_x4u_sale" model="ir.ui.view">
        <field name="name">sale.order.list.x4u.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x4u_proforma_id" string="PI" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="x4u_stage" widget="badge" optional="show"
                       decoration-info="x4u_stage == 'accepted'" decoration-warning="x4u_stage == 'with_accountant'"
                       decoration-danger="x4u_stage == 'returned'" decoration-success="x4u_stage == 'confirmed'"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_x4u_sale" model="ir.ui.view">
        <field name="name">sale.order.search.x4u.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="before">
                <filter name="x4u_stage_accepted" string="Accepted (waiting for documents)" domain="[('x4u_stage', '=', 'accepted')]"/>
                <filter name="x4u_stage_returned" string="Returned to Sales" domain="[('x4u_stage', '=', 'returned')]"/>
                <filter name="x4u_po_to_check" string="To Approve (Accountant)"
                        domain="[('state', 'in', ('draft', 'sent')), ('x4u_po_check', 'in', ('to_check', 'match'))]"/>
                <filter name="x4u_po_mismatch" string="Customer PO Doesn't Match" domain="[('x4u_po_check', '=', 'mismatch')]"/>
                <separator/>
            </xpath>
            <!-- Q1: the order is found by its PI number. -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="x4u_proforma_ids" string="PI" filter_domain="[('x4u_proforma_ids.name', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

    <!-- v0.9 C3: the documents a customer may send with its orders (Sales › Configuration). -->
    <record id="x4u_sale_document_type_view_list" model="ir.ui.view">
        <field name="name">x4u.sale.document.type.list</field>
        <field name="model">x4u.sale.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="x4u_sale_document_type_action" model="ir.actions.act_window">
        <field name="name">Order Documents</field>
        <field name="res_model">x4u.sale.document.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The documents some customers send with each order</p>
            <p>Trade licence, TRN certificate... Tick them on the customer (Sales &amp; Purchase tab): every order of
               it asks for them before it goes to the Accountant.</p>
        </field>
    </record>
    <menuitem id="menu_x4u_sale_document_type" name="Order Documents" parent="sale.menu_sale_config"
              action="x4u_sale_document_type_action" sequence="40"
              groups="sales_team.group_sale_manager,account.group_account_invoice"/>

    <!-- Payment: the sales order (and PI) it is a payment for (S7) -->
    <record id="view_account_payment_form_x4u_sale" model="ir.ui.view">
        <field name="name">account.payment.form.x4u.sale</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="x4u_commercial_partner_id" invisible="1"/>
                <field name="x4u_sale_order_id" options="{'no_create': True}"
                       invisible="partner_type != 'customer' or payment_type != 'inbound'"
                       readonly="state not in ('draft', 'in_process')"/>
                <field name="x4u_proforma_id" invisible="not x4u_proforma_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_x4u_sale" model="ir.ui.view">
        <field name="name">account.payment.search.x4u.sale</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x4u_sale_order_id"/>
                <field name="x4u_proforma_id"/>
            </xpath>
        </field>
    </record>

    <!-- Payment terms: paid before delivery (S10), Custom (S3) -->
    <record id="view_payment_term_form_x4u_sale" model="ir.ui.view">
        <field name="name">account.payment.term.form.x4u.sale</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/field[@name='company_id']" position="after">
                <field name="x4u_pay_before_delivery"/>
                <field name="x4u_custom"/>
            </xpath>
        </field>
    </record>

    <!-- Settings › Sales › Invoicing -->
    <record id="res_config_settings_view_form_x4u_sale" model="ir.ui.view">
        <field name="name">res.config.settings.form.x4u.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']" position="inside">
                <setting id="x4u_sale_accountant" string="Payment to-dos"
                         help="The Accountant who gets them: a quotation sent with its customer PO and first payment, a payment receipt, a payment on its due date, a generator ready for its tax invoice.">
                    <field name="x4u_accountant_user_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Customer: the Orders tab (S4) -->
    <record id="view_partner_form_x4u_sale" model="ir.ui.view">
        <field name="name">res.partner.form.x4u.sale</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="x4u_document_type_ids" widget="many2many_tags" readonly="parent_id"
                       groups="sales_team.group_sale_salesman,account.group_account_invoice"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="before">
                <page string="Orders" name="x4u_orders" invisible="not id"
                      groups="sales_team.group_sale_salesman,account.group_account_invoice,account.group_account_readonly">
                    <field name="x4u_sale_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date_order" widget="date"/>
                            <field name="client_order_ref"/>
                            <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                            <field name="payment_term_id" optional="show"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="x4u_po_check" widget="badge"
                                   decoration-success="x4u_po_check == 'match'" decoration-warning="x4u_po_check == 'to_check'"
                                   decoration-danger="x4u_po_check == 'mismatch'"/>
                            <field name="x4u_amount_advance" optional="show"/>
                            <field name="x4u_amount_remaining"/>
                            <field name="invoice_status" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
