<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- P3 / P4: the printed PO says how and when we pay, like form P00947. -->
    <template id="report_purchaseorder_document_x4u_purchase" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='o.payment_term_id']" position="after">
            <t t-if="o.x4u_payment_mode">
                · <strong>Payment Mode: </strong><span t-field="o.x4u_payment_mode"/>
            </t>
            <table class="table table-sm mt-2" t-if="len(o.x4u_schedule_ids) > 1 or o.x4u_schedule_custom">
                <thead>
                    <tr>
                        <th class="text-start">Payment</th>
                        <th class="text-start">When</th>
                        <th class="text-end">%</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.x4u_schedule_ids" t-as="payment">
                        <td><t t-out="payment_index + 1"/></td>
                        <td>
                            <span t-field="payment.trigger"/>
                            <t t-if="payment.trigger == 'invoice' and payment.days"> <t t-out="payment.days"/> days</t>
                        </td>
                        <td class="text-end"><t t-out="'%g' % payment.percent"/>%</td>
                        <td class="text-end"><span t-field="payment.amount_total"/></td>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
