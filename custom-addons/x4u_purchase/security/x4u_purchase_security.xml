<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The vendor PI is the Accountant's (spec §4); Purchasing sees its status on the PO. -->
        <record id="x4u_purchase_proforma_company_rule" model="ir.rule">
            <field name="name">Vendor PI: multi-company</field>
            <field name="model_id" ref="model_x4u_purchase_proforma"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="x4u_purchase_schedule_company_rule" model="ir.rule">
            <field name="name">Purchase payment schedule: multi-company</field>
            <field name="model_id" ref="model_x4u_purchase_schedule"/>
            <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
