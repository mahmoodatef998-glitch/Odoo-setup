<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer terms (spec §9) and supplier credit terms (blueprint C11).
             Immediate and 30 Days already come with Odoo. -->
        <record id="payment_term_advance_100" model="account.payment.term">
            <field name="name">100% Advance</field>
            <field name="note">Payment terms: 100% advance payment.</field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'percent', 'value_amount': 100.0, 'nb_days': 0})]"/>
        </record>
        <record id="payment_term_50_50" model="account.payment.term">
            <field name="name">50% Advance / 50% Before Delivery</field>
            <field name="note">Payment terms: 50% advance, 50% before delivery.</field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'percent', 'value_amount': 50.0, 'nb_days': 0}), Command.create({'value': 'percent', 'value_amount': 50.0, 'nb_days': 0})]"/>
        </record>
        <record id="payment_term_60_days" model="account.payment.term">
            <field name="name">60 Days</field>
            <field name="note">Payment terms: 60 Days</field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'percent', 'value_amount': 100.0, 'nb_days': 60})]"/>
        </record>
        <record id="payment_term_90_days" model="account.payment.term">
            <field name="name">90 Days</field>
            <field name="note">Payment terms: 90 Days</field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'percent', 'value_amount': 100.0, 'nb_days': 90})]"/>
        </record>
        <record id="payment_term_lc_sight" model="account.payment.term">
            <field name="name">LC at Sight</field>
            <field name="note">Payment terms: Letter of Credit at sight.</field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'percent', 'value_amount': 100.0, 'nb_days': 0})]"/>
        </record>
    </data>
</odoo>
