# HTTPS in front of Odoo (compose.prod.yaml). Caddy gets and renews the Let's Encrypt
# certificate for ODOO_DOMAIN by itself; port 80 only redirects to HTTPS.
{$ODOO_DOMAIN} {
	encode zstd gzip

	# The login page lists the pilot and training databases (list_db), but nobody creates,
	# copies, drops, backs up or restores a database from the internet, and the external
	# XML-RPC / JSON-RPC API stays closed until an integration needs it.
	@blocked path /web/database/manager* /web/database/create* /web/database/duplicate* /web/database/drop* /web/database/backup* /web/database/restore* /web/database/change_password* /xmlrpc/* /jsonrpc*
	respond @blocked 404

	# Odoo 18 with workers: live updates (chat, notifications) go to the gevent port.
	@websocket path /websocket*
	reverse_proxy @websocket web:8072
	reverse_proxy web:8069

	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
